# Copy to /etc/gaia/auto-deploy.env; shell assignments only.
GAIA_REPO_URL=https://github.com/pascaldisse/gaia-daemon.git
GAIA_REPO_DIR=/opt/gaia-source
GAIA_BRANCH=main
GAIA_DEPLOY_DIR=/opt/gaia
GAIA_PORT=8787
GAIA_HEALTH_URL=http://127.0.0.1:8787/
# Optional independent public-route gate.
# GAIA_PUBLIC_HEALTH_URL=https://example.invalid/gaia/
# Optional GAIA Space rollout in the same timer.
GAIA_SPACE_AUTO_DEPLOY=0
GAIA_SPACE_REPO_URL=https://github.com/pascaldisse/gaia-space.git
GAIA_SPACE_REPO_DIR=/opt/gaia-space-repo
GAIA_SPACE_BRANCH=master
GAIA_SPACE_REVISION_FILE=/opt/gaia-space/REVISION
GAIA_SPACE_ROLLOUT=deploy/rollout.sh
