# Copy to /etc/gaia/telegram.env with owner root:gaia and mode 0640.
# Required values: TELEGRAM_BOT_TOKEN, GAIA_WORKSPACE_ID, GAIA_ROOM_ID,
# GAIA_BRIDGE_USERNAME, GAIA_BRIDGE_PASSWORD. TELEGRAM_CHAT_ID is optional
# for initial chat-id discovery; the bridge logs the observed id and exits.
TELEGRAM_BOT_TOKEN=
GAIA_WORKSPACE_ID=
GAIA_ROOM_ID=
GAIA_BRIDGE_USERNAME=
GAIA_BRIDGE_PASSWORD=
# TELEGRAM_CHAT_ID=
